# Copy these placeholders into your local environment. Never commit real values.
DB_URL=jdbc:mysql://localhost:3306/lankastay_db
DB_USERNAME=lankastay_app
DB_PASSWORD=replace-with-local-secret
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:5174
SESSION_COOKIE_SECURE=false

# Production Mail Provider Placeholders (Optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@lankastay.local
MAIL_PASSWORD=replace-with-local-secret

# Bootstrap Manager Initializer (Only used when staff_users table has no MANAGER)
BOOTSTRAP_ADMIN_EMAIL=manager@example.invalid
BOOTSTRAP_ADMIN_TEMP_PASSWORD=replace-with-a-unique-temporary-password
